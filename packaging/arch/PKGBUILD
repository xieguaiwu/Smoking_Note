# Maintainer: xgw <xieguaiwu@163.com>
pkgname=smoke
pkgver=1.1.0
pkgrel=1
pkgdesc="A simple and lightweight command-line note-taking application"
arch=('x86_64')
url="https://github.com/xieguaiwu/Smoking_Note"
license=('custom')
depends=('glibc')
makedepends=('gcc')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('b60e63e4fbc737bf9aced388cf88f83a05b555e1837c535c76490cbdb781ca43')

build() {
    cd "Smoking_Note-$pkgver"
    gcc smoke.c -o smoke -O2
}

package() {
    cd "Smoking_Note-$pkgver"
    install -Dm755 smoke "$pkgdir/usr/bin/smoke"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm755 check_notes.sh "$pkgdir/usr/bin/smoke-check-notes"
}
